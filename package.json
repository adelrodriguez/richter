{
  "name": "richter",
  "version": "0.2.0",
  "description": "Atomic rate limiting with pluggable stores",
  "keywords": [
    "bun",
    "fixed-window",
    "ioredis",
    "rate-limit",
    "rate-limiting",
    "ratelimit",
    "redis",
    "sliding-window",
    "token-bucket",
    "upstash",
    "valkey"
  ],
  "homepage": "https://github.com/adelrodriguez/richter#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/richter/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/richter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stores/memory": {
      "types": "./dist/stores/memory.d.ts",
      "import": "./dist/stores/memory.js",
      "default": "./dist/stores/memory.js"
    },
    "./stores/bun-redis": {
      "types": "./dist/stores/bun-redis.d.ts",
      "import": "./dist/stores/bun-redis.js",
      "default": "./dist/stores/bun-redis.js"
    },
    "./stores/redis": {
      "types": "./dist/stores/redis.d.ts",
      "import": "./dist/stores/redis.js",
      "default": "./dist/stores/redis.js"
    },
    "./stores/valkey": {
      "types": "./dist/stores/valkey.d.ts",
      "import": "./dist/stores/valkey.js",
      "default": "./dist/stores/valkey.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "bench": "vitest bench --run --project \"unit (bench)\" --experimental.viteModuleRunner=false",
    "bench:bun-redis-store": "bun --bun vitest bench --run --project \"bun-redis-store (bench)\"",
    "bench:redis-store": "vitest bench --run --project \"redis-store (bench)\"",
    "bench:valkey-store": "vitest bench --run --project \"valkey-store (bench)\"",
    "build": "tsdown",
    "build:debug": "tsdown --no-minify --sourcemap",
    "build:verify": "pnpm run build && node scripts/verify-build.ts",
    "bump:deps": "pnpm update --interactive",
    "check": "adamantite check",
    "dev": "tsdown --no-minify --sourcemap --watch",
    "fix": "adamantite fix",
    "release": "changeset publish",
    "test": "vitest run --project unit",
    "test:bun-redis-store": "bun --bun vitest run --project bun-redis-store",
    "test:compat:bun": "pnpm run build && bun scripts/compat/bun.mjs dist",
    "test:compat:node": "pnpm run build && node scripts/compat/node.mjs dist",
    "test:coverage": "vitest run --project unit --coverage",
    "test:redis-store": "vitest run --project redis-store",
    "test:valkey-store": "vitest run --project valkey-store",
    "test:watch": "vitest --project unit",
    "version": "changeset version && pnpm run fix"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "adamantite": "0.43.0",
    "ioredis": "6.0.0",
    "iovalkey": "0.4.0",
    "knip": "6.40.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "redis": "6.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "unplugin-macros": "0.23.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
